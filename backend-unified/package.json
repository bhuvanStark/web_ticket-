{
  "name": "tasktel-unified-backend",
  "version": "1.0.0",
  "description": "TaskTel Unified Backend - Serves Customer, Admin, and Technician portals",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test": "node --test --test-isolation=none tests/**/*.test.js",
    "test:integration": "npm run db:migrate && node --test --test-isolation=none integration-tests/**/*.test.js"
  },
  "keywords": [
    "tasktel",
    "backend",
    "customer",
    "admin",
    "technician",
    "service",
    "management"
  ],
  "author": "TaskTel Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
