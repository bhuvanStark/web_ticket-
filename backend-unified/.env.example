# ============================================================================
#  TaskTel backend — environment template
#  Copy to .env and fill in real values. .env is git-ignored.
# ============================================================================

# Server. Railway/Render inject PORT automatically.
PORT=5000
NODE_ENV=development

# --- Database --------------------------------------------------------------
# Local native Postgres:  postgresql://postgres:1234@localhost:5432/tasktel
# Railway:                 ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:1234@localhost:5432/tasktel
# SSL auto-enables for non-localhost hosts. Force it with DATABASE_SSL=true|false.
# DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- CORS + email link origins ------------------------------------------------
# Comma-separated exact origins (scheme + host, no trailing slash).
FRONTEND_URLS=http://localhost:3000,http://localhost:5173
# Customer app origin (password-reset / activation email links).
FRONTEND_URL=http://localhost:3000
# Admin app origin (admin password-reset links).
ADMIN_APP_URL=http://localhost:5173

# --- Auth / JWT -----------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate-a-64-plus-char-random-secret
JWT_REFRESH_SECRET=generate-a-different-64-plus-char-random-secret
ACCESS_TOKEN_EXPIRY=7
REFRESH_TOKEN_EXPIRY=30

# --- Email (Gmail SMTP) --------------------------------------------------------
# Port 465 => secure connection; 587 => STARTTLS.
ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# --- One-time admin seed (npm run db:seed) --------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-at-least-12-characters
SEED_ADMIN_NAME=TaskTel Administrator
