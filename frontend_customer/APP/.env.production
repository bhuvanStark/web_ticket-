# ============================================================================
#  TaskTel CUSTOMER app — PRODUCTION build config
#  Vite loads this automatically for `npm run build` (mode=production) and it
#  is NOT overridden by .env. VITE_* values are inlined into the bundle, so
#  this is not secret — but it MUST be correct before you build and upload.
#
#  Set this to the full backend API URL, including /api, no trailing slash.
# ============================================================================
VITE_API_BASE_URL=https://REPLACE_ME_RAILWAY_BACKEND.up.railway.app/api
